# ---- Server (runtime) ----
# PostgreSQL connection string. Without it the server serves the front end only
# and the app runs in demo mode (sample data in the browser).
DATABASE_URL=
# Optional: OAuth client ID (type "Web application") for "Continue with Google".
GOOGLE_CLIENT_ID=
# Set to "production" on Render/Contabo (secure cookies).
NODE_ENV=
PORT=3000
# Optional: extra allowed origins for cross-origin front ends, comma separated.
ALLOWED_ORIGINS=

# ---- Front end (build time) ----
# Only if the API runs on a different origin than the front end.
VITE_API_URL=
